# Live OSF test credentials.
# Copy this file to .env (which is git-ignored) and fill it in, or export these
# variables in your shell before running `make live` / scripts/live-test.sh.

# Personal access token with write access to the test project.
# Create at: https://osf.io/settings/tokens  (scope: osf.full_write)
OSF_TEST_TOKEN=

# 5-char GUIDs from the OSF URL, e.g. https://osf.io/abc12/ → abc12
OSF_TEST_PROJECT=

# Child component GUID (optional; enables the cross-project / 404 tests).
OSF_TEST_COMPONENT=
